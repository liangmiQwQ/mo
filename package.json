    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev:mo": "node scripts/install.ts mo",
    "dev:moi": "node scripts/install.ts moi",
    "dev:mouni": "node scripts/uninstall.ts mo",
    "dev:moiuni": "node scripts/uninstall.ts moi",
    "preview": "node bin/cli.mjs",
    "test": "vp test run",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "release": "bumpp"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/prompts": "^2.4.9",
    "@types/which": "^3.0.4",
    "@typescript/native-preview": "7.0.0-dev.20260611.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue-tui/runtime": "^0.0.3",
    "bumpp": "^11.1.0",
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "tinyexec": "^1.2.4",
    "typescript": "^6.0.3",
    "untildify": "^6.0.0",
    "vite-plus": "^0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.24",
    "vue": "^3.5.38",
    "which": "^7.0.0"
  },
  "packageManager": "pnpm@11.5.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  },
  "inlinedDependencies": {
    "cac": "7.0.0",
    "picocolors": "1.1.1",
    "untildify": "6.0.0"
